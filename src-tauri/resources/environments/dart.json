{
  "id": "dart",
  "name": "Dart",
  "category": "language",
  "file_extension": "dart",
  "install_guide_url": "https://dart.dev/get-dart",
  "presentation": { "accent": "#0175C2" },
  "profile": "script",
  "config_fields": [
    {
      "key": "dart_path",
      "label": "Dart binary",
      "field_type": "file_path",
      "required": true,
      "primary": true,
      "detect": { "commands": ["dart"] }
    }
  ],
  "run": {
    "program": "{{dart_path}}",
    "args": ["run", "{{entry_file}}"]
  },
  "version_probe": { "arg": "--version" }
}
