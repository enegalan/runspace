{
  "id": "nestjs",
  "name": "NestJS",
  "category": "framework",
  "file_extension": "ts",
  "install_guide_url": "https://docs.nestjs.com/",
  "presentation": { "accent": "#e0234e" },
  "profile": "framework",
  "config_fields": [
    {
      "key": "node_path",
      "label": "Node.js binary",
      "field_type": "file_path",
      "required": true,
      "primary": true,
      "detect": { "commands": ["node"] }
    },
    {
      "key": "npm_path",
      "label": "npm binary (skeleton install)",
      "field_type": "file_path",
      "required": false,
      "detect": { "commands": ["npm"] }
    }
  ],
  "run": {
    "program": "{{node_path}}",
    "args": ["{{entry_file}}"]
  },
  "skeleton": {
    "bundled_dir": "nestjs",
    "sync_exclude_dirs": ["node_modules"],
    "sync_exclude_files": [],
    "dependency_install": {
      "program": "{{npm_path}}",
      "args": ["ci", "--no-audit", "--no-fund"],
      "vendor_marker": "node_modules/@nestjs/core/package.json",
      "manifest_files": ["package.json", "package-lock.json"]
    }
  },
  "prepare": {
    "output": "runspace_bootstrap.js",
    "template": "node_modules_bootstrap.tpl"
  },
  "terminal_env": {
    "framework_root": "RUNSPACE_FRAMEWORK_ROOT",
    "workspace": "RUNSPACE_WORKSPACE"
  },
  "version_probe": { "arg": "--version" }
}
