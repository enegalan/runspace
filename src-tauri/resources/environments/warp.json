{
  "id": "warp",
  "name": "Warp",
  "category": "framework",
  "file_extension": "rs",
  "install_guide_url": "https://www.rust-lang.org/tools/install",
  "presentation": { "accent": "#732738" },
  "profile": "framework",
  "config_fields": [
    {
      "key": "cargo_path",
      "label": "Cargo binary",
      "field_type": "file_path",
      "required": true,
      "primary": true,
      "detect": { "commands": ["cargo"] }
    }
  ],
  "run": {
    "program": "/bin/sh",
    "args": ["{{entry_file}}"]
  },
  "skeleton": {
    "bundled_dir": "warp",
    "sync_exclude_dirs": ["target"],
    "sync_exclude_files": [],
    "dependency_install": {
      "program": "{{cargo_path}}",
      "args": ["build", "--locked", "--quiet"],
      "vendor_marker": "target/CACHEDIR.TAG",
      "manifest_files": ["Cargo.toml", "Cargo.lock"]
    }
  },
  "prepare": {
    "output": "_runspace_bootstrap.sh",
    "template": "cargo_bootstrap.tpl"
  },
  "terminal_env": {
    "framework_root": "RUNSPACE_FRAMEWORK_ROOT",
    "workspace": "RUNSPACE_WORKSPACE"
  },
  "version_probe": { "arg": "--version" }
}
