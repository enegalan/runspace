import path from 'node:path';
import { pathToFileURL } from 'node:url';
import { register } from 'node:module';

const skeletonRoot = '{{skeleton_root}}';
const entryFile = '{{entry_file}}';

process.env.RUNSPACE_FRAMEWORK_ROOT = skeletonRoot;
process.env.RUNSPACE_ENTRY_PATH = entryFile;

const skeletonPkg = path.join(skeletonRoot, 'package.json');

const hookSource = `import { createRequire } from 'node:module';
import { pathToFileURL } from 'node:url';
const require = createRequire(${JSON.stringify(skeletonPkg)});
export async function resolve(specifier, context, nextResolve) {
  if (specifier.startsWith('.') || specifier.startsWith('/') || specifier.startsWith('node:')) {
    return nextResolve(specifier, context);
  }
  try {
    return { shortCircuit: true, url: pathToFileURL(require.resolve(specifier)).href };
  } catch {
    return nextResolve(specifier, context);
  }
}`;

register(`data:text/javascript,${encodeURIComponent(hookSource)}`, pathToFileURL(entryFile));
await import(pathToFileURL(entryFile).href);
