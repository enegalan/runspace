{
  "id": "streamlit",
  "name": "Streamlit",
  "category": "framework",
  "file_extension": "py",
  "install_guide_url": "https://docs.streamlit.io/get-started/installation",
  "presentation": { "accent": "#ff4b4b" },
  "profile": "framework",
  "config_fields": [
    {
      "key": "python_path",
      "label": "Python binary",
      "field_type": "file_path",
      "required": true,
      "primary": true,
      "detect": { "commands": ["python3", "python"] }
    },
    {
      "key": "pip_path",
      "label": "pip binary (skeleton install)",
      "field_type": "file_path",
      "required": false,
      "detect": { "commands": ["pip3", "pip"] }
    }
  ],
  "run": {
    "program": "{{python_path}}",
    "args": ["{{entry_file}}"]
  },
  "skeleton": {
    "bundled_dir": "streamlit",
    "sync_exclude_dirs": ["vendor", ".venv"],
    "sync_exclude_files": [],
    "dependency_install": {
      "program": "{{pip_path}}",
      "args": ["install", "-r", "requirements.lock", "--target", "vendor", "--no-cache-dir"],
      "vendor_marker": "vendor/streamlit/__init__.py",
      "manifest_files": ["requirements.txt", "requirements.lock"]
    }
  },
  "prepare": {
    "output": "_runspace_bootstrap.py",
    "template": "pip_vendor_bootstrap.tpl"
  },
  "terminal_env": {
    "framework_root": "RUNSPACE_FRAMEWORK_ROOT",
    "workspace": "RUNSPACE_WORKSPACE"
  },
  "version_probe": { "arg": "--version" }
}
