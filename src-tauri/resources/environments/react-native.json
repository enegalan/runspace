{
  "id": "react-native",
  "name": "React Native",
  "category": "framework",
  "file_extension": "tsx",
  "install_guide_url": "https://reactnative.dev/docs/environment-setup",
  "presentation": { "accent": "#61dafb" },
  "profile": "framework",
  "config_fields": [
    {
      "key": "node_path",
      "label": "Node.js binary",
      "field_type": "file_path",
      "required": true,
      "primary": true,
      "detect": { "commands": ["node"] }
    },
    {
      "key": "npm_path",
      "label": "npm binary (skeleton install)",
      "field_type": "file_path",
      "required": false,
      "detect": { "commands": ["npm"] }
    }
  ],
  "run": {
    "program": "{{node_path}}",
    "args": ["{{entry_file}}"]
  },
  "skeleton": {
    "bundled_dir": "react-native",
    "sync_exclude_dirs": ["node_modules"],
    "sync_exclude_files": [],
    "dependency_install": {
      "program": "{{npm_path}}",
      "args": ["ci", "--no-audit", "--no-fund"],
      "vendor_marker": "node_modules/react-native/package.json",
      "manifest_files": ["package.json", "package-lock.json"]
    }
  },
  "prepare": {
    "output": "runspace_bootstrap.js",
    "template": "node_modules_bootstrap.tpl"
  },
  "terminal_env": {
    "framework_root": "RUNSPACE_FRAMEWORK_ROOT",
    "workspace": "RUNSPACE_WORKSPACE"
  },
  "version_probe": { "arg": "--version" }
}
