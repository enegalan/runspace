{
  "id": "laravel",
  "name": "Laravel",
  "category": "framework",
  "file_extension": "php",
  "install_guide_url": "https://laravel.com/docs/installation",
  "presentation": { "accent": "#ff2d20" },
  "profile": "framework",
  "config_fields": [
    {
      "key": "php_path",
      "label": "PHP binary",
      "field_type": "file_path",
      "required": true,
      "primary": true,
      "detect": { "commands": ["php"] }
    },
    {
      "key": "composer_path",
      "label": "Composer binary (skeleton install)",
      "field_type": "file_path",
      "required": false,
      "detect": { "commands": ["composer"] }
    }
  ],
  "run": {
    "program": "{{php_path}}",
    "args": ["{{entry_file}}"]
  },
  "skeleton": {
    "bundled_dir": "laravel",
    "sync_exclude_dirs": ["vendor", "storage/logs", "storage/framework/cache", "storage/framework/sessions", "storage/framework/views"],
    "sync_exclude_files": ["database/database.sqlite", "bootstrap/cache/*.php"],
    "dependency_install": {
      "program": "{{composer_path}}",
      "args": ["install", "--no-interaction", "--prefer-dist", "--no-scripts"],
      "vendor_marker": "vendor/autoload.php",
      "manifest_files": ["composer.json", "composer.lock"]
    }
  },
  "prepare": {
    "output": "runspace_bootstrap.php",
    "template": "php_vendor_bootstrap.tpl"
  },
  "post_install": [
    { "type": "create_empty_file", "path": "database/database.sqlite" },
    {
      "type": "run",
      "program": "{{php_path}}",
      "cwd": "skeleton",
      "args": ["artisan", "migrate", "--force", "--no-interaction"]
    }
  ],
  "terminal_env": {
    "framework_root": "RUNSPACE_FRAMEWORK_ROOT",
    "workspace": "RUNSPACE_WORKSPACE"
  },
  "version_probe": { "arg": "--version" }
}
