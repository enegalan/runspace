{
  "id": "aspnet-core",
  "name": "ASP.NET Core",
  "category": "framework",
  "file_extension": "cs",
  "install_guide_url": "https://dotnet.microsoft.com/download",
  "presentation": { "accent": "#512BD4" },
  "profile": "framework",
  "config_fields": [
    {
      "key": "dotnet_path",
      "label": ".NET SDK binary",
      "field_type": "file_path",
      "required": true,
      "primary": true,
      "detect": { "commands": ["dotnet"] }
    }
  ],
  "run": {
    "program": "{{dotnet_path}}",
    "args": ["run", "--file", "{{entry_file}}"]
  },
  "skeleton": {
    "bundled_dir": "aspnet-core",
    "sync_exclude_dirs": ["bin", "obj"],
    "sync_exclude_files": [],
    "dependency_install": {
      "program": "{{dotnet_path}}",
      "args": ["restore", "--no-cache"],
      "vendor_marker": "obj/project.assets.json",
      "manifest_files": ["RunspaceAspNetSandbox.csproj"]
    }
  },
  "prepare": {
    "output": "_runspace_bootstrap.cs",
    "template": "aspnet_core_bootstrap.tpl"
  },
  "terminal_env": {
    "framework_root": "RUNSPACE_FRAMEWORK_ROOT",
    "workspace": "RUNSPACE_WORKSPACE"
  },
  "version_probe": { "arg": "--version" }
}
