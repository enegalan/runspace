{
  "id": "roda",
  "name": "Roda",
  "category": "framework",
  "file_extension": "rb",
  "install_guide_url": "https://roda.jeremyevans.net/",
  "presentation": { "accent": "#5c6bc0" },
  "profile": "framework",
  "config_fields": [
    {
      "key": "ruby_path",
      "label": "Ruby binary",
      "field_type": "file_path",
      "required": true,
      "primary": true,
      "detect": { "commands": ["ruby"] }
    },
    {
      "key": "bundle_path",
      "label": "Bundler binary (skeleton install)",
      "field_type": "file_path",
      "required": false,
      "detect": { "commands": ["bundle"] }
    }
  ],
  "run": {
    "program": "{{ruby_path}}",
    "args": ["{{entry_file}}"]
  },
  "skeleton": {
    "bundled_dir": "roda",
    "sync_exclude_dirs": ["vendor", ".bundle"],
    "sync_exclude_files": [],
    "dependency_install": {
      "program": "{{bundle_path}}",
      "args": ["install", "--path", "vendor/bundle"],
      "vendor_marker": ".bundle/config",
      "manifest_files": ["Gemfile", "Gemfile.lock"]
    }
  },
  "prepare": {
    "output": "_runspace_bootstrap.rb",
    "template": "bundle_bootstrap.tpl"
  },
  "terminal_env": {
    "framework_root": "RUNSPACE_FRAMEWORK_ROOT",
    "workspace": "RUNSPACE_WORKSPACE"
  },
  "version_probe": { "arg": "--version" }
}
