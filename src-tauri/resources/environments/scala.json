{
  "id": "scala",
  "name": "Scala",
  "category": "language",
  "file_extension": "scala",
  "install_guide_url": "https://www.scala-lang.org/download/",
  "presentation": { "accent": "#DC322F" },
  "profile": "script",
  "config_fields": [
    {
      "key": "scala_path",
      "label": "Scala binary",
      "field_type": "file_path",
      "required": true,
      "primary": true,
      "detect": { "commands": ["scala"] }
    }
  ],
  "run": {
    "program": "{{scala_path}}",
    "args": ["{{entry_file}}"]
  },
  "version_probe": { "arg": "--version" }
}
