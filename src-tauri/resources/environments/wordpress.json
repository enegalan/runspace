{
  "id": "wordpress",
  "name": "WordPress",
  "category": "framework",
  "file_extension": "php",
  "install_guide_url": "https://wordpress.org/download/",
  "presentation": { "accent": "#21759b" },
  "profile": "framework",
  "config_fields": [
    {
      "key": "php_path",
      "label": "PHP binary",
      "field_type": "file_path",
      "required": true,
      "primary": true,
      "detect": { "commands": ["php"] }
    },
    {
      "key": "composer_path",
      "label": "Composer binary (skeleton install)",
      "field_type": "file_path",
      "required": false,
      "detect": { "commands": ["composer"] }
    }
  ],
  "run": {
    "program": "{{php_path}}",
    "args": ["{{entry_file}}"]
  },
  "skeleton": {
    "bundled_dir": "wordpress",
    "sync_exclude_dirs": ["vendor", "wordpress/wp-content/database"],
    "sync_exclude_files": [],
    "dependency_install": {
      "program": "{{composer_path}}",
      "args": ["install", "--no-interaction", "--prefer-dist", "--no-scripts"],
      "vendor_marker": "vendor/autoload.php",
      "manifest_files": ["composer.json", "composer.lock"]
    }
  },
  "prepare": {
    "output": "_runspace_bootstrap.php",
    "template": "wordpress_bootstrap.tpl"
  },
  "post_install": [
    { "type": "create_dir", "path": "wordpress/wp-content/uploads" },
    { "type": "create_dir", "path": "wordpress/wp-content/database" }
  ],
  "terminal_env": {
    "framework_root": "RUNSPACE_FRAMEWORK_ROOT",
    "workspace": "RUNSPACE_WORKSPACE"
  },
  "version_probe": { "arg": "--version" }
}
