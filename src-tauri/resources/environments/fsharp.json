{
  "id": "fsharp",
  "name": "F#",
  "category": "language",
  "file_extension": "fsx",
  "install_guide_url": "https://dotnet.microsoft.com/download",
  "presentation": { "accent": "#378BBA" },
  "profile": "script",
  "config_fields": [
    {
      "key": "dotnet_path",
      "label": ".NET SDK binary",
      "field_type": "file_path",
      "required": true,
      "primary": true,
      "detect": { "commands": ["dotnet"] }
    }
  ],
  "run": {
    "program": "{{dotnet_path}}",
    "args": ["fsi", "--exec", "{{entry_file}}"]
  },
  "version_probe": { "arg": "--version" }
}
