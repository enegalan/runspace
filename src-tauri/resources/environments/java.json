{
  "id": "java",
  "name": "Java",
  "category": "language",
  "file_extension": "java",
  "install_guide_url": "https://www.oracle.com/java/technologies/downloads/",
  "presentation": { "accent": "#e61f24" },
  "profile": "script",
  "config_fields": [
    {
      "key": "java_path",
      "label": "Java binary",
      "field_type": "file_path",
      "required": true,
      "primary": true,
      "detect": { "commands": ["java"] }
    }
  ],
  "run": {
    "program": "{{java_path}}",
    "args": ["{{entry_file}}"]
  },
  "version_probe": { "arg": "-version" }
}
