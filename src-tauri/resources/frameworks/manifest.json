{
  "skeletonVersion": "4",
  "frameworks": {
    "laravel": {
      "createProject": "laravel/laravel",
      "versionConstraint": "12.*"
    },
    "symfony": {
      "createProject": "symfony/skeleton",
      "versionConstraint": "7.4.*",
      "extraPackages": ["webapp"]
    },
    "express": {
      "npmPackage": "express",
      "versionConstraint": "^5.0.0"
    },
    "gin": {
      "goModule": "runspace/gin-sandbox",
      "goPackage": "github.com/gin-gonic/gin",
      "versionConstraint": "v1.10.0"
    }
  }
}
