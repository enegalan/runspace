{
  "skeletonVersion": "5",
  "frameworks": {
    "laravel": {
      "createProject": "laravel/laravel",
      "versionConstraint": "12.*"
    },
    "symfony": {
      "createProject": "symfony/skeleton",
      "versionConstraint": "7.4.*",
      "extraPackages": ["webapp"]
    },
    "express": {
      "npmPackage": "express",
      "versionConstraint": "^5.0.0"
    },
    "solidstart": {
      "npmPackage": "@solidjs/start",
      "versionConstraint": "^1.3.0"
    },
    "jhipster": {
      "generatorVersion": "8.8.0"
    },
    "rocket": {
      "crate": "rocket",
      "version": "0.5.1",
      "features": ["json"]
    },
    "actix-web": {
      "cargoPackage": "actix-web",
      "versionConstraint": "4"
    },
    "buffalo": {
      "module": "github.com/runspace/buffalo-sandbox",
      "versionConstraint": "v1.1.4"
    },
    "django": {
      "pipPackage": "django",
      "versionConstraint": "~=4.2.0",
      "projectName": "runspace_project"
    },
    "play": {
      "playVersion": "3.0.7",
      "scalaVersion": "3.3.6",
      "sbtVersion": "1.10.7"
    },
    "flask": {
      "pipPackage": "flask",
      "versionConstraint": "3.1.*"
    },
    "koa": {
      "npmPackage": "koa",
      "versionConstraint": "^3.0.0"
    },
    "hono": {
      "npmPackage": "hono",
      "versionConstraint": "^4.0.0",
      "extraNpmPackages": ["@hono/node-server"]
    },
    "fastify": {
      "npmPackage": "fastify",
      "versionConstraint": "^5.0.0"
    },
    "nestjs": {
      "npmPackages": [
        "@nestjs/core",
        "@nestjs/common",
        "@nestjs/platform-express",
        "reflect-metadata",
        "rxjs",
        "ts-node",
        "typescript"
      ],
      "versionConstraint": "^11.0.0"
    }
  }
}
