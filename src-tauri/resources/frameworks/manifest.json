{
  "skeletonVersion": "4",
  "frameworks": {
    "laravel": {
      "createProject": "laravel/laravel",
      "versionConstraint": "12.*"
    },
    "symfony": {
      "createProject": "symfony/skeleton",
      "versionConstraint": "7.4.*",
      "extraPackages": ["webapp"]
    },
    "express": {
      "npmPackage": "express",
      "versionConstraint": "^5.0.0"
    },
    "dropwizard": {
      "archetypeVersion": "4.0.16",
      "groupId": "com.runspace",
      "artifactId": "sandbox",
      "packageName": "com.runspace.sandbox",
      "name": "RunspaceSandbox"
    }
  }
}
