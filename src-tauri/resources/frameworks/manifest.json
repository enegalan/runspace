{
  "skeletonVersion": "4",
  "frameworks": {
    "laravel": {
      "createProject": "laravel/laravel",
      "versionConstraint": "12.*"
    },
    "symfony": {
      "createProject": "symfony/skeleton",
      "versionConstraint": "7.4.*",
      "extraPackages": ["webapp"]
    },
    "express": {
      "npmPackage": "express",
      "versionConstraint": "^5.0.0"
    },
    "nancy": {
      "dotnetTemplate": "web",
      "nancyVersion": "2.0.0",
      "owinVersion": "3.1.2",
      "roslynVersion": "4.14.0"
    }
  }
}
