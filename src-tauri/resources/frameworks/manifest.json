{
  "skeletonVersion": "4",
  "frameworks": {
    "laravel": {
      "createProject": "laravel/laravel",
      "versionConstraint": "12.*"
    },
    "symfony": {
      "createProject": "symfony/skeleton",
      "versionConstraint": "7.4.*",
      "extraPackages": ["webapp"]
    },
    "express": {
      "npmPackage": "express",
      "versionConstraint": "^5.0.0"
    },
    "aspnet-core": {
      "dotnetTemplate": "web",
      "projectName": "RunspaceAspNetSandbox",
      "scriptingPackage": "Microsoft.CodeAnalysis.CSharp.Scripting"
    },
    "padrino": {
      "gemPackage": "padrino",
      "versionConstraint": ">= 0.15.0"
    }
  }
}
