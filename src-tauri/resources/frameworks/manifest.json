{
  "skeletonVersion": "4",
  "frameworks": {
    "laravel": {
      "createProject": "laravel/laravel",
      "versionConstraint": "12.*"
    },
    "symfony": {
      "createProject": "symfony/skeleton",
      "versionConstraint": "7.4.*",
      "extraPackages": ["webapp"]
    },
    "cakephp": {
      "createProject": "cakephp/app",
      "versionConstraint": "5.3.*"
    },
    "express": {
      "npmPackage": "express",
      "versionConstraint": "^5.0.0"
    }
  }
}
