{
  "skeletonVersion": "4",
  "frameworks": {
    "laravel": {
      "createProject": "laravel/laravel",
      "versionConstraint": "12.*"
    },
    "symfony": {
      "createProject": "symfony/skeleton",
      "versionConstraint": "7.4.*",
      "extraPackages": ["webapp"]
    },
    "laminas": {
      "createProject": "laminas/laminas-mvc-skeleton",
      "versionConstraint": "2.4.*",
      "stability": "dev"
    },
    "express": {
      "npmPackage": "express",
      "versionConstraint": "^5.0.0"
    }
  }
}
